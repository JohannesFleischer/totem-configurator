diff --git a/keyboards/geigeigeist/totem/keymaps/vial/overlay_report.c b/keyboards/geigeigeist/totem/keymaps/vial/overlay_report.c
new file mode 100644
index 00000000..6f5d1106
--- /dev/null
+++ b/keyboards/geigeigeist/totem/keymaps/vial/overlay_report.c
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// totem-keybard overlay report: lets the desktop overlay follow the layer you're on.
+//
+// A read-only Raw HID command next to VIA/Vial's. Requests and replies carry a tag
+// ("TKOV" and a client byte), so the overlay and the editor can share the keyboard:
+// each one ignores the other's replies.
+//
+//   request  [0] 0xF0  [1..4] 'T' 'K' 'O' 'V'  [5] what  [6] client tag  [7] 0  [8..] arguments
+//   reply    the same, with [7] = OVL_VERSION and the answer from [8]
+//
+// A reply with [7] == 0 was not handled (Vial ignores everything else while an unlock
+// is in progress); [0] == 0xFF means a firmware without this report.
+//
+// Nothing here changes the keyboard. Held keys are only reported while the keyboard
+// is unlocked, the same rule Vial applies to its own key tester.
+
+#include QMK_KEYBOARD_H
+#include <string.h>
+#include "via.h"
+#include "vial.h"
+#include "dynamic_keymap.h"
+
+#define OVL_CMD 0xF0
+#define OVL_VERSION 1
+
+enum {
+    OVL_STATE      = 0x01, // layers, modifiers, Caps Lock / Caps Word, unlock, held keys
+    OVL_INFO       = 0x02, // layer/macro/tap dance... counts and the keyboard UID
+    OVL_KEYMAP     = 0x03, // read keymap bytes, like VIA's dynamic_keymap_get_buffer
+    OVL_KEYMAP_SUM = 0x04, // a checksum of the whole keymap, to notice edits
+};
+
+#define OVL_KEYMAP_MAX 20 // keymap bytes per reply
+
+static const uint8_t ovl_magic[4] = {'T', 'K', 'O', 'V'};
+
+static void put32(uint8_t *p, uint32_t v) {
+    p[0] = v & 0xFF;
+    p[1] = (v >> 8) & 0xFF;
+    p[2] = (v >> 16) & 0xFF;
+    p[3] = (v >> 24) & 0xFF;
+}
+
+static uint16_t keymap_size(void) {
+    return (uint16_t)dynamic_keymap_get_layer_count() * MATRIX_ROWS * MATRIX_COLS * 2;
+}
+
+void raw_hid_receive_kb(uint8_t *data, uint8_t length) {
+    if (length < 32 || data[0] != OVL_CMD || memcmp(&data[1], ovl_magic, 4) != 0) {
+        data[0] = id_unhandled; // as VIA's default handler
+        return;
+    }
+    uint8_t *p = &data[8];
+    switch (data[5]) {
+        case OVL_STATE: {
+            memset(p, 0, length - 8);
+            put32(&p[0], (uint32_t)layer_state);
+            put32(&p[4], (uint32_t)default_layer_state);
+            p[8] = get_mods() | get_oneshot_mods();
+            uint8_t flags = 0;
+            if (host_keyboard_led_state().caps_lock) flags |= 1 << 0;
+#ifdef CAPS_WORD_ENABLE
+            if (is_caps_word_on()) flags |= 1 << 1;
+#endif
+            if (vial_unlocked) {
+                flags |= 1 << 2;
+#if MATRIX_COLS <= 8 && MATRIX_ROWS <= 16
+                for (uint8_t row = 0; row < MATRIX_ROWS; row++) p[10 + row] = (uint8_t)matrix_get_row(row);
+                flags |= 1 << 3; // held keys included
+#endif
+            }
+            p[9] = flags;
+            break;
+        }
+        case OVL_INFO: {
+            memset(p, 0, length - 8);
+            p[0] = dynamic_keymap_get_layer_count();
+            p[1] = dynamic_keymap_macro_get_count();
+            p[2] = MATRIX_ROWS;
+            p[3] = MATRIX_COLS;
+            // tap dance, combo, key override and alt repeat counts + feature bits, as Vial reports them
+            uint8_t counts[32] = {id_vial_prefix, vial_dynamic_entry_op, 0x00 /* number of entries */};
+            vial_handle_cmd(counts, sizeof counts);
+            memcpy(&p[4], counts, 4);
+            p[8] = counts[31];
+            uint8_t uid[8] = VIAL_KEYBOARD_UID;
+            memcpy(&p[9], uid, 8);
+            put32(&p[17], VIAL_PROTOCOL_VERSION);
+            break;
+        }
+        case OVL_KEYMAP: {
+            uint16_t offset = ((uint16_t)p[0] << 8) | p[1];
+            uint8_t  size   = p[2];
+            if (size > OVL_KEYMAP_MAX) size = OVL_KEYMAP_MAX;
+            p[2] = size;
+            dynamic_keymap_get_buffer(offset, size, &p[3]);
+            break;
+        }
+        case OVL_KEYMAP_SUM: {
+            // Fletcher-16 over the whole keymap, read in small pieces
+            uint16_t total = keymap_size(), a = 0, b = 0;
+            uint8_t  buf[32];
+            for (uint16_t off = 0; off < total; off += sizeof buf) {
+                uint8_t n = (uint16_t)(total - off) < (uint16_t)sizeof buf ? (uint8_t)(total - off) : (uint8_t)sizeof buf;
+                dynamic_keymap_get_buffer(off, n, buf);
+                for (uint8_t i = 0; i < n; i++) {
+                    a = (a + buf[i]) % 255;
+                    b = (b + a) % 255;
+                }
+            }
+            memset(p, 0, length - 8);
+            p[0] = a;
+            p[1] = b;
+            p[2] = total >> 8;
+            p[3] = total & 0xFF;
+            break;
+        }
+        default:
+            return; // unknown: [7] stays 0
+    }
+    data[7] = OVL_VERSION;
+}
diff --git a/keyboards/geigeigeist/totem/keymaps/vial/rules.mk b/keyboards/geigeigeist/totem/keymaps/vial/rules.mk
index 4f7618e9..a2acb32e 100644
--- a/keyboards/geigeigeist/totem/keymaps/vial/rules.mk
+++ b/keyboards/geigeigeist/totem/keymaps/vial/rules.mk
@@ -1,2 +1,12 @@
 VIA_ENABLE = yes
 VIAL_ENABLE = yes
+
+# totem-keybard build: features the TOTEM's official prebuilt Vial firmware has but the
+# vial-qmk definition leaves out: mouse keys, media/system keys (volume, play, sleep, ...)
+# and dynamic macros (DM_REC1/DM_PLY1 on the TOTEM's RAISE layer).
+MOUSEKEY_ENABLE = yes
+EXTRAKEY_ENABLE = yes
+DYNAMIC_MACRO_ENABLE = yes
+
+# totem-keybard overlay: a read-only Raw HID report of the live layer (overlay_report.c)
+SRC += overlay_report.c
